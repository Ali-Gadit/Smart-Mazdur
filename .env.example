# Application Environment Variables Example
# Copy this file to .env.local for local development.
# Do not commit real secrets or production keys to version control.

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Public Configuration (Accessible in browser and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-Only Secret (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Operational Marketplace Defaults
NEXT_PUBLIC_DEFAULT_CURRENCY=PKR
NEXT_PUBLIC_MARKETPLACE_NAME=Smart Mazdur
NEXT_PUBLIC_DEFAULT_CITY=Karachi

# Optional Integrations (Leave blank if not configured; system defaults to graceful local fallbacks)
MAPS_PROVIDER=
MAPS_API_KEY=
SMS_PROVIDER=
SMS_API_KEY=
WHATSAPP_PROVIDER=
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
